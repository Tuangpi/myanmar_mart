# Copy to .env and adjust for your machine.

NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (T002)
DATABASE_URL="postgresql://postgres:12345@localhost:5432/myanmar_mart?schema=public"

# Auth (T003) — use a long random value outside development
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# Local file storage for uploads (T009, T014)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=5

LOG_LEVEL=info

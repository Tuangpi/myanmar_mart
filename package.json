{
  "name": "myanmart",
  "version": "0.1.0",
  "private": true,
  "description": "MyanMart — a Myanmar-first multi-vendor e-commerce marketplace.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build --workspace @myanmart/shared",
    "dev": "concurrently -n shared,api,web -c gray,blue,magenta \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev --workspace @myanmart/shared",
    "dev:api": "npm run dev --workspace @myanmart/api",
    "dev:web": "npm run dev --workspace @myanmart/web",
    "build": "npm run build --workspace @myanmart/shared && npm run build --workspace @myanmart/api && npm run build --workspace @myanmart/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "clean": "rimraf apps/*/dist apps/*/node_modules packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
